{
  "name": "folium",
  "module": "index.tsx",
  "type": "module",
  "license": "MIT",
  "version": "1.1.1",
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "tsdown && bun copy-style",
    "copy-style": "cp ./core/styles.css ./dist/styles.css"
  },
  "author": {
    "name": "iSaulX"
  },
  "packageManager": "bun@1.3.5",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./wrapper": {
      "import": {
        "types": "./dist/wrapper/index.d.ts",
        "default": "./dist/wrapper/index.js"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "devDependencies": {
    "@playwright/test": "^1.37.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@types/bun": "^1.3.5",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "babel-plugin-react-compiler": "^1.0.0",
    "bunchee": "^5.1.5",
    "eslint": "^7.32.0",
    "prettier": "^2.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.18.3",
    "turbo": "1.6",
    "typescript": "5"
  },
  "bugs": {
    "url": "https://github.com/iSaulX/folium/issues"
  },
  "homepage": "https://folium-react.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iSaulX/folium.git"
  },
  "keywords": [
    "react",
    "drawer",
    "component",
    "ui",
    "sheet",
    "radix-ui",
    "overlay",
    "typescript"
  ],
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.1"
  },
  "peerDependencies": {
    "react": "^16.8 || ^17.0 || ^18.0 || ^19.0.0 || ^19.0.0-rc",
    "react-dom": "^16.8 || ^17.0 || ^18.0 || ^19.0.0 || ^19.0.0-rc"
  }
}
